HOST=127.0.0.1
PORT=3001
DATABASE_PATH=./data/fieldwork.sqlite
WEB_ORIGIN=http://localhost:5173
# Enable only behind HTTPS when deploying.
COOKIE_SECURE=false
# On a physical device, use your computer's LAN address instead of localhost.
EXPO_PUBLIC_API_URL=http://localhost:3001
# Maps load only after an explicit web action. Set false to disable tile maps.
MAPS_ENABLED=true
# To use another provider, set all four fields and restart the API.
# MAP_PROVIDER_NAME=Your tile provider
# MAP_TILE_URL=https://tiles.example.com/{z}/{x}/{y}.png
# MAP_ATTRIBUTION_TEXT=Provider attribution
# MAP_ATTRIBUTION_URL=https://example.com/attribution
# MAP_MAX_ZOOM=19
