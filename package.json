{
  "name": "fieldwork",
  "version": "0.1.0",
  "license": "MIT",
  "repository": "github:tedy69/fieldwork",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24.3.0 <25"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm run dev -w @fieldwork/api\" \"npm run dev -w @fieldwork/web\"",
    "db:seed": "tsx --env-file-if-exists=.env apps/api/src/seed.ts",
    "user:create": "tsx --env-file-if-exists=.env apps/api/src/create-user.ts",
    "build": "npm run typecheck && npm run build -w @fieldwork/web",
    "start": "tsx --env-file-if-exists=.env apps/api/src/main.ts",
    "mobile": "npm run start -w @fieldwork/mobile",
    "typecheck": "tsc --noEmit && npm run typecheck -w @fieldwork/mobile",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run typecheck && npm test && npm run build -w @fieldwork/web"
  },
  "dependencies": {
    "tsx": "4.23.15"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "^24.0.0",
    "@types/react": "~19.3.0",
    "@types/react-dom": "^19.3.0",
    "concurrently": "^9.2.1",
    "prettier": "^3.6.2",
    "typescript": "~6.0.3",
    "vitest": "5.0.5"
  }
}
